<Window xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="using:lab1.UI.ViewModels"
        xmlns:models="using:lab1.Core.Models"
        xmlns:providers="using:lab1.Core.Providers"
        xmlns:c="using:lab1.UI.Converters"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d" d:DesignWidth="900" d:DesignHeight="720"
        x:Class="lab1.UI.Views.MainWindow"
        x:DataType="vm:MainViewModel"
        Icon="/Assets/avalonia-logo.ico"
        Width="900" Height="720"
        MinWidth="640" MinHeight="560"
        Title="Fast Food Simulator">

    <Design.DataContext>
        <vm:MainViewModel />
    </Design.DataContext>

    <Window.Resources>
        <c:NullableIntToTextConverter x:Key="OrderNumberConverter" />
        <c:NullOrEmptyToDashConverter x:Key="NameConverter" />
    </Window.Resources>

    <Window.Styles>
        <Style Selector="Border.card">
            <Setter Property="Background" Value="#22888888" />
            <Setter Property="BorderBrush" Value="#33888888" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="8" />
            <Setter Property="Padding" Value="16" />
            <Setter Property="Margin" Value="8" />
        </Style>
        <Style Selector="TextBlock.header">
            <Setter Property="FontSize" Value="15" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Margin" Value="0,0,0,8" />
        </Style>
        <Style Selector="TextBlock.value">
            <Setter Property="FontSize" Value="28" />
            <Setter Property="FontWeight" Value="SemiBold" />
        </Style>
        <Style Selector="TextBlock.caption">
            <Setter Property="Opacity" Value="0.7" />
            <Setter Property="Margin" Value="0,2,0,0" />
        </Style>
        <Style Selector="StackPanel.idle">
            <Setter Property="Opacity" Value="0.35" />
        </Style>
    </Window.Styles>

    <DockPanel Margin="8">
        <Border DockPanel.Dock="Top" Classes="card" Margin="8,8,8,4">
            <StackPanel Spacing="8">
                <WrapPanel Orientation="Horizontal" ItemSpacing="16" LineSpacing="8">
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Arrival (sec)" VerticalAlignment="Center" />
                        <TextBox Width="90" Text="{Binding ArrivalSecondsText}"
                                 IsEnabled="{Binding IsNotRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Ordering (sec)" VerticalAlignment="Center" />
                        <TextBox Width="90" Text="{Binding OrderingSecondsText}"
                                 IsEnabled="{Binding IsNotRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Prep (sec)" VerticalAlignment="Center" />
                        <TextBox Width="90" Text="{Binding PrepSecondsText}"
                                 IsEnabled="{Binding IsNotRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Cashiers" VerticalAlignment="Center" />
                        <NumericUpDown Width="120" Minimum="1" Maximum="10" Increment="1"
                                       Value="{Binding OrderTakerCount}"
                                       IsEnabled="{Binding IsNotRunning}" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Spacing="8">
                        <TextBlock Text="Cooks" VerticalAlignment="Center" />
                        <NumericUpDown Width="120" Minimum="1" Maximum="10" Increment="1"
                                       Value="{Binding CookCount}"
                                       IsEnabled="{Binding IsNotRunning}" />
                    </StackPanel>
                    <Button Content="Start" Command="{Binding StartCommand}"
                            MinWidth="80" VerticalAlignment="Center" />
                    <Button Content="Stop" Command="{Binding StopCommand}"
                            MinWidth="80" VerticalAlignment="Center" />
                </WrapPanel>
                <TextBlock Text="{Binding ValidationMessage}"
                           Foreground="#E81123"
                           FontWeight="SemiBold"
                           TextWrapping="Wrap"
                           IsVisible="{Binding HasError}" />
            </StackPanel>
        </Border>

        <UniformGrid Rows="2" Columns="2">
            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Classes="header" Text="Order Line" />
                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="value" Text="{Binding OrderLineCount}" />
                        <TextBlock Classes="caption" Text="Customers waiting to place an order" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" MinHeight="100"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OrderLineCustomers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Customer">
                                    <StackPanel Width="92" Margin="4" Spacing="4">
                                        <Border Background="#FFEDEDED"
                                                CornerRadius="10"
                                                Padding="6"
                                                HorizontalAlignment="Center">
                                            <Image Source="avares://lab1.UI/Assets/human.png"
                                                   Width="72" Height="72"
                                                   Stretch="Uniform" />
                                        </Border>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Surname}"
                                                   FontSize="12" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Classes="header" Text="Order Takers" />
                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="value" Text="{Binding OrderTakerCount}" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" MinHeight="100"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding OrderTakers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="providers:WorkerSnapshot">
                                    <StackPanel Width="92" Margin="4" Spacing="4"
                                                Classes.idle="{Binding IsIdle}">
                                        <Panel HorizontalAlignment="Center">
                                            <Border Background="#FFEDEDED"
                                                    CornerRadius="10"
                                                    Padding="6">
                                                <Image Source="avares://lab1.UI/Assets/human.png"
                                                       Width="72" Height="72"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <Border Background="#FF3B82F6"
                                                    CornerRadius="9"
                                                    Padding="6,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top"
                                                    IsVisible="{Binding IsBusy}">
                                                <TextBlock Text="{Binding OrderNumber, Converter={StaticResource OrderNumberConverter}}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Panel>
                                        <TextBlock Text="{Binding CustomerName, Converter={StaticResource NameConverter}}"
                                                   FontSize="12" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding CustomerSurname, Converter={StaticResource NameConverter}}"
                                                   FontSize="12" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Classes="header" Text="Pickup Counter" />
                    <StackPanel Grid.Row="1">
                        <TextBlock Classes="value" Text="{Binding ServingLineCount}" />
                        <TextBlock Classes="caption" Text="Customers waiting for pickup" />
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" MinHeight="100"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <ItemsControl ItemsSource="{Binding PickupWaitingCustomers}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <WrapPanel Orientation="Horizontal" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate x:DataType="models:Customer">
                                    <StackPanel Width="92" Margin="4" Spacing="4">
                                        <Panel HorizontalAlignment="Center">
                                            <Border Background="#FFEDEDED"
                                                    CornerRadius="10"
                                                    Padding="6">
                                                <Image Source="avares://lab1.UI/Assets/human.png"
                                                       Width="72" Height="72"
                                                       Stretch="Uniform" />
                                            </Border>
                                            <Border Background="#FF3B82F6"
                                                    CornerRadius="9"
                                                    Padding="6,1"
                                                    HorizontalAlignment="Right"
                                                    VerticalAlignment="Top">
                                                <TextBlock Text="{Binding Receipt.Number, StringFormat='#{0}'}"
                                                           Foreground="White"
                                                           FontSize="12"
                                                           FontWeight="SemiBold" />
                                            </Border>
                                        </Panel>
                                        <TextBlock Text="{Binding Name}"
                                                   FontSize="12" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding Surname}"
                                                   FontSize="12" TextAlignment="Center"
                                                   TextTrimming="CharacterEllipsis" />
                                    </StackPanel>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Border>

            <Border Classes="card">
                <Grid RowDefinitions="Auto,Auto,*">
                    <TextBlock Grid.Row="0" Classes="header" Text="Kitchen" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal" Spacing="24">
                        <StackPanel>
                            <TextBlock Classes="caption" Text="Cooks" />
                            <TextBlock Classes="value" Text="{Binding CookCount}" />
                        </StackPanel>
                        <StackPanel>
                            <TextBlock Classes="caption" Text="Waiting orders" />
                            <TextBlock Classes="value" Text="{Binding KitchenWaitingCount}" />
                        </StackPanel>
                    </StackPanel>
                    <ScrollViewer Grid.Row="2" Margin="0,8,0,0" MinHeight="120"
                                  HorizontalScrollBarVisibility="Disabled"
                                  VerticalScrollBarVisibility="Auto">
                        <StackPanel Spacing="8">
                            <ItemsControl ItemsSource="{Binding Cooks}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="providers:WorkerSnapshot">
                                        <StackPanel Width="92" Margin="4" Spacing="4"
                                                    Classes.idle="{Binding IsIdle}">
                                            <Panel HorizontalAlignment="Center">
                                                <Border Background="#FFEDEDED"
                                                        CornerRadius="10"
                                                        Padding="6">
                                                    <Image Source="avares://lab1.UI/Assets/human.png"
                                                           Width="72" Height="72"
                                                           Stretch="Uniform" />
                                                </Border>
                                                <Border Background="#FF3B82F6"
                                                        CornerRadius="9"
                                                        Padding="6,1"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        IsVisible="{Binding IsBusy}">
                                                    <TextBlock Text="{Binding OrderNumber, Converter={StaticResource OrderNumberConverter}}"
                                                               Foreground="White"
                                                               FontSize="12"
                                                               FontWeight="SemiBold" />
                                                </Border>
                                            </Panel>
                                            <TextBlock Text="{Binding CustomerName, Converter={StaticResource NameConverter}}"
                                                       FontSize="12" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                            <TextBlock Text="{Binding CustomerSurname, Converter={StaticResource NameConverter}}"
                                                       FontSize="12" TextAlignment="Center"
                                                       TextTrimming="CharacterEllipsis" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                            <ItemsControl ItemsSource="{Binding KitchenWaitingOrders}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel Orientation="Horizontal" />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate x:DataType="models:Order">
                                        <Border Background="#22888888"
                                                BorderBrush="#33888888"
                                                BorderThickness="1"
                                                CornerRadius="6"
                                                Padding="8,2"
                                                Margin="3">
                                            <TextBlock Text="{Binding Number, StringFormat='#{0}'}"
                                                       FontWeight="SemiBold" />
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </ScrollViewer>
                </Grid>
            </Border>
        </UniformGrid>
    </DockPanel>
</Window>
